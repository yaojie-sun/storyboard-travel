/**
 * 通过Banana API生成图像（新版本）
 */
export async function bananaGenerateImage(request: GenerateRequest): Promise<string> {
  const startedAt = performance.now();
  console.info('[Banana] generate_image request', {
    ...sanitizeGenerateRequestForLog(request),
    tauri: isTauri(),
  });

  if (!isTauri()) {
    throw new Error('当前不是 Tauri 容器环境，请使用 `npm run tauri dev` 启动');
  }

  try {
    const result = await invoke<string>('banana_call_image_api', {
      prompt: request.prompt,
      model: request.model,
      size: request.size,
      aspect_ratio: request.aspect_ratio,
      reference_images: request.reference_images,
      extra_params: request.extra_params,
    });

    const elapsedMs = Math.round(performance.now() - startedAt);
    console.info('[Banana] generate_image success', {
      elapsedMs,
      resultPreview: truncateText(result, 220),
    });
    return result;
  } catch (error) {
    const elapsedMs = Math.round(performance.now() - startedAt);
    const normalizedError = normalizeInvokeError(error);
    console.error('[Banana] generate_image failed', {
      elapsedMs,
      request: sanitizeGenerateRequestForLog(request),
      error,
      normalizedError,
    });

    // 检查是否为余额不足错误
    if (normalizedError.message.includes('INSUFFICIENT_CREDITS')) {
      // 触发支付流程
      await handleInsufficientCredits();
      // 支付成功后重试
      return bananaGenerateImage(request);
    }

    // 检查是否为未登录错误
    if (normalizedError.message.includes('设备令牌未找到') ||
        normalizedError.message.includes('未授权') ||
        normalizedError.message.includes('401')) {
      triggerLoginRequired();
      throw createErrorWithDetails('请先登录', '需要登录后才能使用AI生成功能');
    }

    const commandError: ErrorWithDetails = new Error(normalizedError.message);
    commandError.details = normalizedError.details;
    throw commandError;
  }
}

/**
 * 处理余额不足的情况
 */
async function handleInsufficientCredits(): Promise<void> {
  console.info('[Banana] 余额不足，启动支付流程');

  try {
    // 获取定价配置（这里可以使用默认值或从服务器获取）
    // 暂时使用固定值：899元=50次，1599元=100次
    const pricingOptions = [
      { amount: 899, credits: 50 },
      { amount: 1599, credits: 100 },
    ];

    // 默认选择第一个选项
    const selectedOption = pricingOptions[0];

    // 创建支付订单
    const paymentOrder = await bananaCreatePaymentOrder(
      selectedOption.amount,
      selectedOption.credits,
      'alipay'
    );

    console.info('[Banana] 创建支付订单成功:', paymentOrder.order_id);

    // 触发支付弹窗
    triggerPaymentRequired(paymentOrder);

    // 等待支付完成
    const paid = await waitForPaymentCompletion(paymentOrder.order_id);

    if (!paid) {
      throw new Error('支付未完成或已取消');
    }

    console.info('[Banana] 支付成功，可以继续使用');
  } catch (error) {
    console.error('[Banana] 支付流程失败:', error);
    throw new Error('支付流程失败: ' + (error instanceof Error ? error.message : String(error)));
  }
}

/**
 * 等待支付完成
 */
async function waitForPaymentCompletion(orderId: string, maxAttempts: number = 60): Promise<boolean> {
  console.info('[Banana] 等待支付完成:', orderId);

  for (let attempt = 0; attempt < maxAttempts; attempt++) {
    try {
      await new Promise(resolve => setTimeout(resolve, 5000)); // 每5秒检查一次

      const status = await bananaCheckPaymentStatus(orderId);
      console.info(`[Banana] 支付状态检查 ${attempt + 1}/${maxAttempts}:`, status.status);

      if (status.paid) {
        return true;
      }

      if (status.status === 'failed' || status.status === 'cancelled') {
        throw new Error(`支付失败或已取消: ${status.status}`);
      }
    } catch (error) {
      console.error('[Banana] 检查支付状态失败:', error);
      // 继续重试
    }
  }

  return false;
}

