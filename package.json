{
  "name": "storyboard-travel",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "cross-env TAURI_MOBILE=1 vite",
    "build": "tsc --noEmit && vite build || vite build",
    "build:mobile": "cross-env TAURI_MOBILE=1 vite build",
    "build:tauri": "node scripts/build-tauri.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:android:dev": "cross-env TAURI_MOBILE=1 npx tauri android dev",
    "tauri:android:build": "cross-env TAURI_MOBILE=1 npx tauri android build",
    "tauri:ios:dev": "cross-env TAURI_MOBILE=1 npx tauri ios dev",
    "tauri:ios:build": "cross-env TAURI_MOBILE=1 npx tauri ios build",
    "sync:version": "node scripts/Sync-version.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.75.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.5.0",
    "fflate": "^0.8.2",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "konva": "^9.3.22",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^5.5.6",
    "react-i18next": "^15.4.1",
    "react-image-crop": "^11.0.10",
    "react-konva": "^18.2.10",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.3",
    "vite": "^6.1.0"
  }
}
